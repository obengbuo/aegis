# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed when you enable the GitHub MCP server.
# Create at https://github.com/settings/tokens (fine-grained, read-only is safest)
GITHUB_TOKEN=github_pat_...

# Optional — only needed when you enable the Postgres MCP server.
# Local docker option:
#   docker run --name aegis-pg -e POSTGRES_PASSWORD=test -p 5432:5432 -d postgres
POSTGRES_URL=postgresql://postgres:test@localhost:5432/postgres

# Optional — only needed when you enable the Brave Search MCP server.
# Free key at https://brave.com/search/api/
BRAVE_API_KEY=...
